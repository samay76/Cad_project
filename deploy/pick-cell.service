# systemd *user* service: the MuJoCo windows need the logged-in user's desktop session (DISPLAY).
#   deploy/install.sh installs it; manage with: systemctl --user status|restart|stop pick-cell
[Unit]
Description=Pick cell server (web app, MuJoCo simulation, EC66 + Robotiq 2F-85)
After=graphical-session.target network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
# A ROS (or other) PYTHONPATH from the desktop session must not leak into the cell's Python.
Environment=PYTHONPATH=
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-@REPO@/.env
ExecStart=@PYTHON@ -m server
# SIGTERM stops a running job first (in Real Sim that sends `stop` to the robot)
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
