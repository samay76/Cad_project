# Copy to .env (git-ignored) and adjust for this PC. Values in the real environment win over this file.

# Where the server listens. 127.0.0.1 = only this PC; 0.0.0.0 = reachable from the cell network.
CELL_HOST=127.0.0.1
CELL_PORT=8000

# Python that runs the jobs (default: the one running the server)
# CELL_PYTHON=/home/<user>/miniforge3/envs/pick-cell/bin/python

# Configuration and data (defaults: config/cell.json and var/)
# CELL_CONFIG=/path/to/cell.json
# CELL_DATA_DIR=/path/to/data

# Run folders kept in var/runs (older ones are deleted when a new run starts)
CELL_KEEP_RUNS=200

# X display the MuJoCo windows open on
DISPLAY=:0
