<?xml version="1.0"?>
<!--
  Robotiq Hand-E, flattened from robotiq_hande_description/urdf/robotiq_hande_gripper.xacro
  (prefix "", xyz/rpy 0, ros2_control removed). Meshes and license: see LICENSE (same package).
  Frames: root = robotiq_hande_coupler = tool flange. Approach = +Z, fingers slide along X.
  Each finger joint 0..0.025 m -> opening between the finger faces 0..50 mm.
  The right finger is an independent joint here (mimic removed) so both can be set separately.
-->
<robot name="robotiq_hande">
  <link name="robotiq_hande_coupler">
    <visual>
      <geometry><mesh filename="package://robotiq_hande_description/meshes/io_coupler.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.00545" rpy="0 0 0"/>
      <geometry><cylinder length="0.0169" radius="0.0385"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.00545" rpy="0 0 0"/>
      <mass value="0.119"/>
      <inertia ixx="4.4664e-05" ixy="0" ixz="0" iyy="4.4664e-05" iyz="0" izz="8.3672e-05"/>
    </inertial>
  </link>

  <joint name="robotiq_hande_base_joint" type="fixed">
    <origin xyz="0 0 0.011" rpy="0 0 0"/>
    <parent link="robotiq_hande_coupler"/>
    <child link="robotiq_hande_link"/>
  </joint>

  <link name="robotiq_hande_link">
    <visual>
      <geometry><mesh filename="package://robotiq_hande_description/meshes/hande.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.05345" rpy="0 0 0"/>
      <geometry><cylinder length="0.1069" radius="0.0385"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0495" rpy="0 0 0"/>
      <mass value="0.86387"/>
      <inertia ixx="0.0010092" ixy="0" ixz="0" iyy="0.0010092" iyz="0" izz="0.00060741"/>
    </inertial>
  </link>

  <joint name="robotiq_hande_left_finger_joint" type="prismatic">
    <origin xyz="0 0 0.099" rpy="0 0 0"/>
    <parent link="robotiq_hande_link"/>
    <child link="robotiq_hande_left_finger"/>
    <axis xyz="1 0 0"/>
    <limit effort="130" lower="0.0" upper="0.025" velocity="0.15"/>
  </joint>

  <link name="robotiq_hande_left_finger">
    <visual>
      <geometry><mesh filename="package://robotiq_hande_description/meshes/finger.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://robotiq_hande_description/meshes/finger_collision.dae"/></geometry>
    </collision>
    <inertial>
      <mass value="0.03804"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>

  <joint name="robotiq_hande_right_finger_joint" type="prismatic">
    <origin xyz="0 0 0.099" rpy="0 0 0"/>
    <parent link="robotiq_hande_link"/>
    <child link="robotiq_hande_right_finger"/>
    <axis xyz="-1 0 0"/>
    <limit effort="130" lower="0.0" upper="0.025" velocity="0.15"/>
  </joint>

  <link name="robotiq_hande_right_finger">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
      <geometry><mesh filename="package://robotiq_hande_description/meshes/finger.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
      <geometry><mesh filename="package://robotiq_hande_description/meshes/finger_collision.dae"/></geometry>
    </collision>
    <inertial>
      <mass value="0.03804"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>

  <joint name="robotiq_hande_end_joint" type="fixed">
    <origin xyz="0 0 0.1455" rpy="0 0 0"/>
    <parent link="robotiq_hande_link"/>
    <child link="robotiq_hande_end"/>
  </joint>
  <link name="robotiq_hande_end"/>
</robot>
